# Copy to scripts/site.env and replace every placeholder for the deployment.
# Values exported by the caller override this file for one-off runs.

PORTAL_HOST="root@<portal-host>"
PORTAL_DIR=/opt/lab-playground
PORTAL_COMPOSE=docker-compose.prod.yml
PORTAL_APP_CONTAINER=proxmox-vm-automation-prod

HEADSCALE_HOST="root@<headscale-host>"
HEADSCALE_DIR=/opt/headscale
HEADSCALE_KEEP_USER=term-infrastructure
HEADSCALE_STAFF=instructor,assistant
EMAIL_DOMAIN=example.edu
REMOTE_BACKUP_DIR=/var/backups/lab-playground
KEY_DAYS=150d

HEADSCALE_URL=https://vpn.example.edu

# --- Jumpbox (docs/JUMPBOX.md) ---------------------------------------------
# Provisioning: scripts/jumpbox_provision.sh, run on JUMPBOX_NODE.
JUMPBOX_NODE=node1
JUMPBOX_STORAGE=local-zfs
# Pick a VMID outside the range the portal allocates for student VMs.
JUMPBOX_VMID="<jumpbox-vmid>"
# Public key file on the node; cloud-init installs it for JUMPBOX_ADMIN_USER.
JUMPBOX_SSH_PUBKEY=/root/jumpbox-admin.pub
JUMPBOX_ADMIN_USER=ubuntu
JUMPBOX_BRIDGE=vmbr0
# VLAN tag of the management NIC (net0); empty for untagged.
JUMPBOX_MGMT_VLAN=1
# The trunk NIC (net1) is untagged on this bridge and carries every lab VLAN.
JUMPBOX_TRUNK_BRIDGE=vmbr0
JUMPBOX_CORES=2
JUMPBOX_MEMORY=4096
# Use 64G or more with --monitoring (Zeek logs + RITA's ClickHouse).
JUMPBOX_DISK_SIZE=32G
JUMPBOX_CLOUD_IMAGE=/var/lib/vz/template/iso/noble-server-cloudimg-amd64.img
JUMPBOX_CLOUD_IMAGE_URL=https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img

# Configuration: scripts/jumpbox_configure.sh, run on the jumpbox. Every value
# below is optional; the comment shows the default.
# JUMPBOX_MGMT_IF=          # default: the interface holding the default route
# JUMPBOX_TRUNK_IF=         # default: the one other physical NIC
# VLAN bands as name:first-last:offset:third; VLAN N gets 10.<N-offset>.<third>.1/24.
# They must cover the portal's VLAN pools (app/vlan_allocator.py, GROUP_*_VLAN_* in .env).
# JUMPBOX_VLAN_BANDS="entry:100-200:0:0 group-entry:300-399:200:2 group-internal:400-500:300:4"
# JUMPBOX_DHCP_START=50     # DHCP pool .50-.254 on every lab VLAN
# JUMPBOX_DHCP_END=254
# JUMPBOX_DHCP_LEASE=12h
# JUMPBOX_DNS_UPSTREAM=8.8.8.8
# Fixed addresses for templates with a static_mac, as band=MAC,hostname,host-number:
# JUMPBOX_DHCP_RESERVATIONS="group-internal=02:00:00:00:00:01,dc,10"
# JUMPBOX_NETPLAN_FILE=/etc/netplan/60-jumpbox-vlans.yaml
# JUMPBOX_DNSMASQ_FILE=/etc/dnsmasq.d/jumpbox.conf
# JUMPBOX_NETPLAN_TRY_TIMEOUT=120
# Staff tailnet addresses (IPv4 and IPv6, comma-separated) that may SSH to the
# jumpbox over tailscale0 with --ssh-staff-only; the management NIC and loopback
# are always allowed. Required unless JUMPBOX_MGMT_IF resolves.
# JUMPBOX_SSH_STAFF_IPS="100.64.0.10,fd7a:115c:a1e0::a"
# JUMPBOX_TS_ROUTES=10.0.0.0/8
# JUMPBOX_TS_TAG=tag:jumpbox
# JUMPBOX_TS_HOSTNAME=
# JUMPBOX_MONITORING_MIN_GB=64
# JUMPBOX_RITA_VERSION=v5.1.1
# JUMPBOX_RITA_DATABASE=jumpbox
# Never put the Headscale auth key here: pass JUMPBOX_TS_AUTHKEY in the
# environment for one run, or use --authkey-stdin.

# Optional student accounts: scripts/jumpbox_accounts.sh, run on the jumpbox.
# Where `create` writes generated username,password lines (mode 0600).
# Keep it untracked; default is ./jumpbox-credentials.csv.
JUMPBOX_CREDENTIALS_FILE=./jumpbox-credentials.csv
# JUMPBOX_LOCK_LIST_DIR=/root   # where lock-stale writes its undo list
