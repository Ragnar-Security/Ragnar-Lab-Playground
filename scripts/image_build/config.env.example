# Image builder configuration. Copy to config.env (untracked) and fill in only
# the section for the backend you build on; build_image.sh asks the backend
# which variables it needs and names any that are missing.
# Override the path with IMAGE_BUILD_CONFIG=/path/to/config.env.
#
# This file is in a public repo: placeholders only. Real hosts, subnet,
# security-group and project IDs belong in config.env.

# --- Proxmox -------------------------------------------------------------------
PVE_HOST=""               # address of the build node, reached as root over SSH
PVE_NODE="pve"            # node that runs the build VM
PVE_REPLICA_NODE="pve2"   # node that receives the template copy
PVE_REPLICA_HOST=""       # address of the replica node
PVE_STORAGE=""            # storage for the build VM's disk on PVE_NODE
PVE_REPLICA_STORAGE=""    # storage for the replica template
PVE_BUILD_BRIDGE=""       # bridge of the provisioning network (has internet)
PVE_BUILD_VLAN=""         # VLAN tag of the provisioning network

# --- AWS (a build VPC, separate from the lab VPC) ---------------------------------
AWS_BUILD_REGION=""       # e.g. us-east-1
AWS_BUILD_SUBNET_ID=""    # public subnet of the build VPC (subnet-...)
AWS_BUILD_SG_ID=""        # admits SSH from the build host only (sg-...)

# --- GCP (a build VPC network, separate from the lab network) ---------------------
GCP_BUILD_PROJECT=""      # project ID
GCP_BUILD_ZONE=""         # e.g. us-east1-b
GCP_BUILD_SUBNET=""       # subnet of the build network
