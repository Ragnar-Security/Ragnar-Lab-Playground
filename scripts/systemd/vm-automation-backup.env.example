# Install as /etc/default/vm-automation-backup (mode 0600) for the
# vm-automation-backup.service unit.

# Required: absolute path of the checkout that holds docker-compose.prod.yml.
COMPOSE_DIR=/path/to/checkout

# Where dumps are written; created if missing.
BACKUP_DIR=/root/backups

# Dumps older than this many days are pruned.
RETENTION_DAYS=14
