# Copy to scripts/site.env and replace every placeholder for the deployment.
# Values exported by the caller override this file for one-off runs.

PORTAL_HOST="root@<portal-host>"
PORTAL_DIR=/opt/lab-playground
PORTAL_COMPOSE=docker-compose.prod.yml
PORTAL_APP_CONTAINER=proxmox-vm-automation-prod

HEADSCALE_HOST="root@<headscale-host>"
HEADSCALE_DIR=/opt/headscale
HEADSCALE_KEEP_USER=term-infrastructure
HEADSCALE_STAFF=instructor,assistant
EMAIL_DOMAIN=example.edu
REMOTE_BACKUP_DIR=/var/backups/lab-playground
KEY_DAYS=150d

HEADSCALE_URL=https://vpn.example.edu
JUMPBOX_NODE=node1
JUMPBOX_STORAGE=local-zfs
# Where configure_jumpbox.sh writes generated username,password lines (mode 0600).
# Keep it untracked; default is ./jumpbox-credentials.csv.
JUMPBOX_CREDENTIALS_FILE=./jumpbox-credentials.csv
