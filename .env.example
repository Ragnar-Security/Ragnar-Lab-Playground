# ==============================================================================
# Lab Playground - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for your environment
# For production deployment, use strong passwords and secure credentials.
# Before `docker compose -f docker-compose.prod.yml up`, check the result with
#   python3 scripts/preflight_env.py .env

# ==============================================================================
# Proxmox Connection Settings
# ==============================================================================
PROXMOX_HOST=proxmox.example.edu
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=your-proxmox-password
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_PORT=8006
# TLS verification of the Proxmox API (default true). For a self-signed
# cluster, point PROXMOX_CA_BUNDLE at its CA certificate (PEM path inside the
# container; mount it at the same path as on the host so preflight_env.py can
# check it) instead of disabling verification. false sends the API
# credentials over an unauthenticated channel and logs a startup warning.
PROXMOX_VERIFY_SSL=true
PROXMOX_CA_BUNDLE=

# ==============================================================================
# Application Settings
# ==============================================================================
# Flask session signing key. Required in production: startup refuses a
# missing, example, or shorter-than-32-character key. Generate with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# Application port (used in docker-compose.prod.yml)
APP_PORT=5000

# Flask environment
FLASK_ENV=production

# Operator-supplied template catalog (relative paths resolve from the app root)
TEMPLATES_FILE=templates.yaml

# Site branding. Empty SITE_BRAND_TAG and SITE_ORG are omitted from the UI.
SITE_NAME=Lab Playground
SITE_BRAND_TAG=
SITE_ORG=

# Optional Headscale/Tailscale login server shown in student setup commands,
# as a full URL including the scheme, e.g. https://vpn.example.edu
# Leave empty to omit the --login-server flag.
VPN_LOGIN_SERVER=

# Caddy public endpoint and ACME account.
SITE_DOMAIN=lab.example.edu
ACME_EMAIL=admin@example.edu

# Container registry coordinates used by image-based Compose deployments.
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_NAME=lab-playground

# ==============================================================================
# Database Configuration
# ==============================================================================
# MySQL database credentials. Required by docker-compose.prod.yml; production
# refuses empty or published example passwords. Generate each with:
#   python -c 'import secrets; print(secrets.token_urlsafe(24))'
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=vmdatabase
MYSQL_USER=vmuser
MYSQL_PASSWORD=
MYSQL_HOST=db
DB_PORT=3306

# Database URL (constructed from above - used by SQLAlchemy)
DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:3306/${MYSQL_DATABASE}

# ==============================================================================
# Node Selection Configuration
# ==============================================================================
# Load balancing configuration
ENABLE_LOAD_BALANCING=true  # Enable intelligent node selection based on resources
# A Proxmox node may not be named aws or gcp: cloud admission uses those names
# as its reservation key, and startup refuses such a FIXED_NODE.
FIXED_NODE=  # Specify a fixed node name when load balancing is disabled

# Resource thresholds for node selection
CPU_THRESHOLD=80.0  # Maximum CPU usage % before avoiding a node
MEMORY_THRESHOLD=85.0  # Maximum memory usage % before avoiding a node
MIN_FREE_MEMORY_GB=2.0  # Minimum free memory in GB required for new VMs

# ==============================================================================
# VM Backends: Proxmox, AWS, Google Cloud (docs/CLOUD_BACKENDS.md)
# ==============================================================================
# Comma list of the backends this portal places labs on: proxmox, aws, gcp.
# proxmox alone (or empty) is the Proxmox-only portal every existing site
# runs; only the enabled backends' settings below are required.
ENABLED_BACKENDS=proxmox

# Ownership tag on every cloud resource this portal creates; required when
# aws or gcp is enabled. 1-20 characters of a-z, 0-9 and '-', not starting or
# ending with '-'. One value per portal: never share it with another portal
# or with a live contract run (which uses its own live-<name> site).
LAB_SITE_ID=

# The jumpbox's VLAN bands, exactly as scripts/site.env sets them for
# jumpbox_configure.sh (docs/JUMPBOX.md). The portal exports them to the
# Headscale policy (scripts/apply_headscale_policy.sh), which grants each
# student only the slots these bands route, on every backend.
JUMPBOX_VLAN_BANDS="entry:100-200:0:0 group-entry:300-399:200:2 group-internal:400-500:300:4"

# --- AWS (needed only when aws is enabled) ---
# Credentials are NOT set here: boto3's standard chain (an instance role, or
# the compose override in docs/CLOUD_BACKENDS.md) supplies them.
# Region and the one availability zone every lab VM launches in, e.g.
# <aws-region> and <aws-availability-zone>.
AWS_REGION=
AWS_AVAILABILITY_ZONE=
# The operator-created lab VPC, e.g. <aws-vpc-id>.
AWS_LAB_VPC_ID=
# Slot base: slot N is the /26 at base + N*64. Must be a /17 or larger, inside
# the VPC's CIDR, and clear of 10.0.0.0/8, 100.64.0.0/10, 172.17.0.0/16 and
# GCP_LAB_CIDR.
AWS_LAB_CIDR=172.20.0.0/16
# The subnet router instance, e.g. <router-instance-id>. It must be tagged
# lab-playground-site=<LAB_SITE_ID> and lab-playground-kind=router.
AWS_ROUTER_INSTANCE_ID=
# Required positive cap on live lab instances; there is no unlimited default.
AWS_MAX_VMS=
# Stop the router after this many minutes with no lab VM and no admission.
AWS_ROUTER_IDLE_MINUTES=30
AWS_LAUNCH_TIMEOUT_SECONDS=600
AWS_TERMINATE_TIMEOUT_SECONDS=600

# --- Google Cloud (needed only when gcp is enabled) ---
# Credentials are NOT set here: Application Default Credentials (the metadata
# server, or the compose override in docs/CLOUD_BACKENDS.md) supply them.
# Project, the region slot subnetworks are created in, the one zone every lab
# VM launches in, and the operator-created custom-mode VPC, e.g.
# <gcp-project>, <gcp-region>, <gcp-zone> and <gcp-network>.
GCP_PROJECT=
GCP_REGION=
GCP_ZONE=
GCP_NETWORK=
# Slot base, same rules as AWS_LAB_CIDR, and clear of it.
GCP_LAB_CIDR=172.21.0.0/16
# The subnet router instance name, e.g. <gcp-router-name>. It must be labelled
# lab-playground-site=<LAB_SITE_ID> and lab-playground-kind=router.
GCP_ROUTER_INSTANCE=
# Required positive cap on live lab instances; there is no unlimited default.
GCP_MAX_VMS=
GCP_ROUTER_IDLE_MINUTES=30
GCP_OPERATION_TIMEOUT_SECONDS=600

# ==============================================================================
# Admin Configuration
# ==============================================================================
# Default admin account (created on first startup). Production refuses to
# create it with a password shorter than 16 characters or a known default:
#   python -c 'import secrets; print(secrets.token_urlsafe(24))'
# Set SEED_ADMIN_ACCOUNT=false to skip creating this generic account when
# staff use personal accounts listed in ADMIN_USERS; ADMIN_PASSWORD is then
# not required. It never removes an account that already exists: to retire
# one, sign in as another admin and send PUT /admin/students/<id> with
# {"disabled": true}.
SEED_ADMIN_ACCOUNT=true
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-this-password-immediately
ADMIN_FULL_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_STUDENT_NAME=admin

# Additional admin users (comma-separated list of login IDs)
ADMIN_USERS=ta1loginid,ta2loginid

# ==============================================================================
# Security Settings (Optional)
# ==============================================================================
# Session cookie. SESSION_COOKIE_SECURE defaults to true in production (HTTPS
# via Caddy) and false otherwise; leave it empty to keep that default.
SESSION_COOKIE_SECURE=
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
# Session timeout in seconds (default 7200, two hours)
PERMANENT_SESSION_LIFETIME=7200

# Student self-service password reset (default false). When on, a student
# proves identity with nothing but their login ID and roster SIS ID: anyone
# who knows both can take the account. Turn it on only if your SIS IDs are
# not widely known; otherwise an administrator issues a reset link.
SELF_SERVICE_PASSWORD_RESET=false

# Lifetime in minutes of an admin-issued, single-use password reset link
# (Students tab, key button). Works regardless of the setting above.
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Reverse proxies in front of the app that append X-Forwarded-For. 0 ignores
# the header (any client can forge it). docker-compose.prod.yml sets 1 for
# Caddy; set it here only when running behind your own proxy.
TRUSTED_PROXY_HOPS=0

# ==============================================================================
# Admin Alert Notifications (Optional)
# ==============================================================================
# Email Notifications (SMTP)
# Configure these to receive email alerts for failed VM deletions
SMTP_SERVER=  # e.g., smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=  # e.g., your-email@gmail.com
SMTP_PASSWORD=  # App password for Gmail or SMTP password
SMTP_FROM_EMAIL=  # Email address to send from
ADMIN_ALERT_EMAILS=  # Comma-separated list: admin@example.com,admin2@example.com

# Webhook Notifications (Slack/Discord)
# Configure these to receive instant notifications via webhook
ALERT_WEBHOOK_URL=  # Discord webhook URL
ALERT_WEBHOOK_TYPE=discord  # 'discord' or 'slack'

# Note: File logging and database alerts are always enabled
# Failed VM deletions are logged to: /app/data/failed_vms.log
# And stored in the admin_alerts database table
# Alerts are queued in the alert_outbox table and delivered by the expiry loop
# within about a minute; a failed channel is retried with backoff.

# Failed-deploy guests that could not be recorded because the database was
# down are written here (mode 0600) and imported once it is back. Optional;
# must stay on the persistent data/ mount.
# UNTRACKED_SURVIVORS_FILE=data/untracked-survivors.jsonl

# VM lifecycle locks across gunicorn workers (default false). Off, each VMID
# is serialized by an in-process lock, which is enough for the single worker
# production runs. On, every holder also takes MySQL GET_LOCK on a second
# database connection. Set it to true BEFORE running more than one worker.
DISTRIBUTED_VM_LOCKS=false

# ==============================================================================
# VM Timing Configuration
# ==============================================================================
# NOTE: VM timing (uptime_minutes, extend_time_minutes), memory, cores, and
# storage are configured per deployment group in templates.yaml.
# There are no environment variables for these settings.
